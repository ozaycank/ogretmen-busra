datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum FileStatus {
  UPLOAD_PENDING // Signed URL verildi, yükleme bekleniyor
  PROCESSING     // QStash worker tarama yapıyor
  APPROVED       // Temiz, yayında
  REJECTED       // Virüslü veya geçersiz format
  ORPHANED       // Zaman aşımına uğramış (Cron ile temizlenecek)
}

enum GradeLevel {
  OKUL_ONCESI
  SINIF_1
  SINIF_2
  SINIF_3
  SINIF_4
  GENEL
}

enum ContentCategory {
  ETKINLIK
  ODEV
  KONU_ANLATIMI
  KODLAMA
  BELIRLI_GUN_VE_HAFTALAR
  UZMAN_NOTLARI
  SINIF_MATERYALLERI
  PIKTES_TURKCE
  DEGERLER_EGITIMI
  INTERAKTIF_OYUN
}
enum Role {
  ADMIN
  MODERATOR
  USER
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Material {
  id            String          @id @default(uuid())
  title         String          @db.VarChar(150) // DB şişirme saldırılarına karşı katı sınır
  description   String?         @db.VarChar(500)
  
  fileKey       String          @unique @db.VarChar(255) // R2'deki gerçek dosya adı (UUID)
  originalName  String          @db.VarChar(255)         // Kullanıcının verdiği ad
  fileUrl       String          @db.Text         // R2 / S3 dosya adresi
  fileType      String          @db.VarChar(10)  // pdf, docx, jpeg kontrolü için
  fileSize      Int                              // Byte cinsinden dosya boyutu kontrolü
  mimeType      String          @db.VarChar(100)
  authorName    String          @db.VarChar(100) // "Büşra Öğretmen" veya Ziyaretçi Ad-Soyad
  
  // Security Lifecycle
  status        FileStatus      @default(UPLOAD_PENDING)
  scanResult    String?         @db.Text                 // Virüs tarama logu/sonucu
  grade         GradeLevel
  category      ContentCategory
  
  // Metrikler
  downloadCount Int             @default(0)
  viewCount     Int             @default(0)
  
  // Güvenlik ve Bot Koruma Katmanı
  ipHash        String          @db.VarChar(64)  // Spam atan IP'leri (hashing ile anonim) engellemek için
  turnstileToken String         @unique          // Cloudflare Turnstile doğrulama token izi
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Performans için Kompoze İndeksler (Sınıf ve kategori filtreleme hızını maksimize eder)
  @@index([status, grade, category])
  @@index([ipHash, createdAt]) // IP bazlı dakikalık yükleme limiti (Rate-limiting) kontrolü sorguları için
}

// Görsel 1: Eğitim Haberleri Modülü
model News {
  id              String     @id @default(uuid())
  title           String     @db.VarChar(200)
  slug            String     @unique @db.VarChar(255) // SEO Dostu URL
  content         String     @db.Text
  imageUrl        String?    @db.Text
  label           String     @db.VarChar(50) 
  
  // CMS Workflow & SEO
  status          PostStatus @default(DRAFT)
  seoTitle        String?    @db.VarChar(60)
  seoDescription  String?    @db.VarChar(160)
  publishedAt     DateTime?  
  
  viewCount       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([slug])
}

// Görsel 3: Alt Kısımdaki Canlı/Toplam İstatistik Sayaçları
model SiteStats {
  id        String   @id @default(uuid())
  date      DateTime @unique @default(now()) @db.Date
  online    Int      @default(0)
  today     Int      @default(0)
  yesterday Int      @default(0)
  total     Int      @default(0)
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique @db.VarChar(255)
  passwordHash        String     @db.VarChar(255)
  name                String     @db.VarChar(100)
  role                Role       @default(USER)
  
  // Güvenlik & Brute-Force Koruması
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  auditLogs           AuditLog[]

  @@index([email])
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  ACCOUNT_LOCKED
  MATERIAL_APPROVED
  MATERIAL_REJECTED
  MATERIAL_DELETED
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?     // Anonim başarısız denemeler için null olabilir
  action    AuditAction
  ipAddress String?     @db.VarChar(64)
  userAgent String?     @db.Text
  details   String?     @db.Text
  createdAt DateTime    @default(now())

  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, action, createdAt])
}